# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Resend API Key (starts with re_...) for transactional lead forwarding emails
RESEND_API_KEY=""

# LEAD_NOTIFICATION_EMAIL: Destination email address for new lead notifications
LEAD_NOTIFICATION_EMAIL="info@alexander-heinz.de"
