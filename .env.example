# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Resend API Key (starts with re_...) for transactional lead forwarding emails
RESEND_API_KEY=""

# LEAD_NOTIFICATION_EMAIL: Destination email address for new lead notifications
LEAD_NOTIFICATION_EMAIL="info@alexander-heinz.de"

# RESEND_FROM_EMAIL: Verifizierte Absenderadresse bei Resend (ohne Angabe: Sandbox onboarding@resend.dev)
RESEND_FROM_EMAIL=""

# ADMIN_TOKEN: Zugang zum Lead-Management (?admin). Mindestens 32 zufällige Zeichen,
# z. B. erzeugen mit: openssl rand -hex 32
ADMIN_TOKEN=""

# LEAD_WEBHOOK_URL: Dauerhafte Ablage der Leads, z. B. Make-Szenario → Google Sheet (https://hook.eu1.make.com/...)
LEAD_WEBHOOK_URL=""

# STRIPE_DEPOSIT_URL: Stripe Payment Link für die erstattbare Anzahlung (https://buy.stripe.com/...)
STRIPE_DEPOSIT_URL=""

# DATA_DIR: Verzeichnis für leads.json und events.json. Im Produktivbetrieb auf ein
# persistentes Volume zeigen lassen (Cloud Run: GCS-Volume), sonst gehen Daten bei Neustarts verloren.
DATA_DIR=""
