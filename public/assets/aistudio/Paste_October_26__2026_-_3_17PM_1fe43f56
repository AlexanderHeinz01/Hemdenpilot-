                        <input type="tel" id="lead-phone" placeholder="+49 170 1234567" class="w-full text-sm p-2.5 rounded-lg border border-slate-300">
                    </div>

                    <p class="text-[10px] text-slate-400">Keine Zahlungsdaten nötig. Du wirst informiert, sobald die Lieferroute in deiner PLZ aktiv wird.</p>

                    <button type="submit" id="submit-btn" class="w-full py-3.5 rounded-xl font-bold text-white bg-emerald-600 hover:bg-emerald-700 transition">
                        Pilotplatz unverbindlich sichern →
                    </button>
                </form>
            </div>

            <!-- MODAL SUCCESS SCREEN -->
            <div id="step-success" class="p-8 text-center hidden">
                <div class="w-12 h-12 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto mb-4 text-xl font-bold">✓</div>
                <h4 class="text-xl font-bold text-slate-900 mb-2">Vormerkung erfolgreich!</h4>
                <p class="text-sm text-slate-600 mb-6">Wir haben deine Reservierung für PLZ <span id="success-plz" class="font-bold"></span> registriert. Eine Bestätigung ist per E-Mail an dich unterwegs.</p>
                <button onclick="closeModal()" class="w-full py-3 rounded-xl font-bold text-slate-800 bg-slate-100 hover:bg-slate-200 transition">Fenster schließen</button>
            </div>

        </div>
    </div>

    <!-- FUNNEL LOGIC & EVENT TRACKING SCRIPT -->
    <script>
        // State
        let funnelData = {
            package: '',
            price: 0,
            size: '',
            fit: '',
            dropoff: '',
            plz: '',
            email: '',
            phone: ''
        };

        // Open Modal (Triggered by Step 1 Package click)
        function openModal(packageName, price) {
            funnelData.package = packageName;
            funnelData.price = price;

            // TRACKING EVENT: Step 1 Package chosen
            trackEvent('select_package', {
                package_name: packageName,
                price: price
            });

            // UI Setup
            document.getElementById('summary-package').innerText = packageName + ' – ' + price + ' € / Monat';
            document.getElementById('modal-step-tag').innerText = 'Schritt 2 von 3';
            document.getElementById('modal-title').innerText = 'Präferenzen festlegen';

            document.getElementById('step-2-content').classList.remove('hidden');
            document.getElementById('step-3-content').classList.add('hidden');
            document.getElementById('step-success').classList.add('hidden');
            document.getElementById('funnel-modal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('funnel-modal').classList.add('hidden');
        }

        // Advance to Step 3
        function goToStep3() {
            funnelData.size = document.getElementById('shirt-size').value;
            funnelData.fit = document.getElementById('shirt-fit').value;
            const dropoffEl = document.querySelector('input[name="dropoff"]:checked');
            funnelData.dropoff = dropoffEl ? dropoffEl.value : 'Unbekannt';

            // TRACKING EVENT: Step 2 completed
            trackEvent('funnel_step_2_completed', {
                size: funnelData.size,
                fit: funnelData.fit,
                dropoff: funnelData.dropoff
            });

            // Switch Screen
            document.getElementById('modal-step-tag').innerText = 'Schritt 3 von 3';
            document.getElementById('modal-title').innerText = 'Route freischalten';
            document.getElementById('step-2-content').classList.add('hidden');
            document.getElementById('step-3-content').classList.remove('hidden');
        }

        // Final Submit (Step 3 Smoke Door)
        function submitForm(event) {
            event.preventDefault();
            
            const btn = document.getElementById('submit-btn');
            btn.innerText = 'Wird verarbeitet...';
            btn.disabled = true;

            funnelData.plz = document.getElementById('lead-plz').value;
            funnelData.email = document.getElementById('lead-email').value;
            funnelData.phone = document.getElementById('lead-phone').value;

            // TRACKING EVENT: Complete Funnel conversion
            trackEvent('lead_reserved', funnelData);

            // Log result in browser console (Inspect -> Console)
            console.log('✅ NEUER LEAD ERFASST (Payload für Webhook):', funnelData);

            /* HINWEIS: Hier kannst du deinen Webhook / Zapier / Formspree Endpoint eintragen:
               fetch('https://formspree.io/f/DEINE_ID', {
                   method: 'POST',
                   headers: { 'Content-Type': 'application/json' },
                   body: JSON.stringify(funnelData)
               });
            */

            setTimeout(() => {
                document.getElementById('success-plz').innerText = funnelData.plz;
                document.getElementById('step-3-content').classList.add('hidden');
                document.getElementById('step-success').classList.remove('hidden');
                btn.innerText = 'Pilotplatz unverbindlich sichern →';
                btn.disabled = false;
            }, 600);
        }

        // Central Analytics Dispatcher (Google Analytics / Meta Pixel)
        function trackEvent(eventName, payload) {
            console.log(`📡 [Tracking] Event: ${eventName}`, payload);
            
            // Falls Google Analytics (gtag) installiert ist:
            if (typeof gtag === 'function') {
                gtag('event', eventName, payload);
            }
            // Falls Meta Pixel (fbq) installiert ist:
            if (typeof fbq === 'function') {
                fbq('trackCustom', eventName, payload);
            }
        }
    </script>
</body>
</html>